# Copia este archivo a .env (NO lo subas a GitHub; ya está en .gitignore) y completa:

# ▼▼▼ AQUÍ VA LA CONEXIÓN DE SUPABASE ▼▼▼
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos que elegiste al crear el proyecto.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave que la app enviará en la cabecera X-API-Key (invéntala larga y aleatoria)
AGENDA_API_KEY=cambia-esto-por-una-clave-larga
AGENDA_TZ=America/Bogota
